rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is admin
    function isAdmin() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.designation == 'admin';
    }
    
    // ============================================
    // USER TRACKING COLLECTION
    // ============================================
    match /user_tracking/{userId} {
      // Users can read their own data
      allow read: if request.auth != null && request.auth.uid == userId;
      
      // Admins can read all user tracking data
      allow read: if request.auth != null && isAdmin();
      
      // Users can create/update their own tracking data
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId;
      
      // Admins can update any user tracking data
      allow update: if request.auth != null && isAdmin();
    }
    
    // ============================================
    // WORKER TRACKING COLLECTION
    // ============================================
    match /worker_tracking/{document} {
      // Any authenticated user can read worker data
      allow read: if request.auth != null;
      
      // Only admins can create/update worker tracking
      allow create: if request.auth != null && isAdmin();
      allow update: if request.auth != null && isAdmin();
      allow delete: if request.auth != null && isAdmin();
    }
    
    // ============================================
    // COMPANY TRACKING COLLECTION
    // ============================================
    match /company_tracking/{document} {
      // Any authenticated user can read company data
      allow read: if request.auth != null;
      
      // Only company owners can create their company record
      allow create: if request.auth != null && 
                       request.resource.data.ownerId == request.auth.uid;
      
      // Only company owners or admins can update
      allow update: if request.auth != null && 
                       (resource.data.ownerId == request.auth.uid || isAdmin());
      
      // Only admins can delete companies
      allow delete: if request.auth != null && isAdmin();
    }
    
    // ============================================
    // USERS COLLECTION (Legacy/App Functionality)
    // ============================================
    match /users/{userId} {
      // Users can read their own data
      allow read: if request.auth != null && request.auth.uid == userId;
      
      // Admins can read all user data
      allow read: if request.auth != null && isAdmin();
      
      // Users can create/update their own profile
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId;
      
      // Admins can update any user profile
      allow update: if request.auth != null && isAdmin();
    }
    
    // ============================================
    // GOOGLE SHEETS DATA (If stored in Firestore)
    // ============================================
    match /sheets_data/{document} {
      // Only authenticated users can read
      allow read: if request.auth != null;
      
      // Only admins can write
      allow write: if request.auth != null && isAdmin();
    }
    
    // ============================================
    // NOTIFICATIONS COLLECTION
    // ============================================
    match /notifications/{notificationId} {
      // Users can read their own notifications
      allow read: if request.auth != null && 
                     resource.data.ToWorkerID == request.auth.uid;
      
      // Admins can read all notifications
      allow read: if request.auth != null && isAdmin();
      
      // Only admins can create notifications
      allow create: if request.auth != null && isAdmin();
      
      // Users can update their own notification read status
      allow update: if request.auth != null && 
                       request.resource.data.ToWorkerID == request.auth.uid;
    }
    
    // ============================================
    // LEAVE REQUESTS COLLECTION
    // ============================================
    match /leave_requests/{requestId} {
      // Workers can read their own requests
      allow read: if request.auth != null && 
                     resource.data.WorkerID == request.auth.uid;
      
      // Admins/Managers can read all requests
      allow read: if request.auth != null && 
                     (isAdmin() || 
                      get(/databases/$(database)/documents/users/$(request.auth.uid)).data.designation == 'manager');
      
      // Workers can create their own requests
      allow create: if request.auth != null && 
                       request.resource.data.WorkerID == request.auth.uid;
      
      // Admins/Managers can update request status
      allow update: if request.auth != null && 
                       (isAdmin() || 
                        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.designation == 'manager');
    }
    
    // ============================================
    // CLOCKINGS COLLECTION
    // ============================================
    match /clockings/{clockingId} {
      // Workers can read their own clockings
      allow read: if request.auth != null && 
                     resource.data.WorkerID == request.auth.uid;
      
      // Admins/Managers can read all clockings
      allow read: if request.auth != null && 
                     (isAdmin() || 
                      get(/databases/$(database)/documents/users/$(request.auth.uid)).data.designation == 'manager');
      
      // Only admins can create/update clockings
      allow create: if request.auth != null && isAdmin();
      allow update: if request.auth != null && isAdmin();
    }
    
    // ============================================
    // DRAWER MONEY COLLECTION
    // ============================================
    match /drawer_money/{document} {
      // Workers can read their own drawer records
      allow read: if request.auth != null && 
                     resource.data.WorkerID == request.auth.uid;
      
      // Admins/Managers can read all drawer records
      allow read: if request.auth != null && 
                     (isAdmin() || 
                      get(/databases/$(database)/documents/users/$(request.auth.uid)).data.designation == 'manager');
      
      // Only admins can write drawer records
      allow write: if request.auth != null && isAdmin();
    }
    
    // ============================================
    // ADMIN ONLY COLLECTIONS
    // ============================================
    match /admin_logs/{document} {
      // Only admins can read/write admin logs
      allow read, write: if request.auth != null && isAdmin();
    }
    
    match /system_settings/{document} {
      // Only admins can read/write system settings
      allow read, write: if request.auth != null && isAdmin();
    }
  }
}
