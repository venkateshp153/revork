rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------------
    // Helpers
    // ---------------------------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    // Google sign-in marks the email as verified. Require it for writes that
    // bind an account to an email address.
    function hasVerifiedEmail() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isSelf(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function userRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.designation;
    }

    // A company admin is the owner of their own workspace. This is NOT a
    // platform-wide role: every self-onboarded company admin is one, so it must
    // never be used to read another company's records.
    function isAdmin() {
      return isSignedIn() && userRole() == 'admin';
    }

    function isManagerOrAdmin() {
      return isSignedIn() && (userRole() == 'admin' || userRole() == 'manager');
    }

    // Reserved for a trusted operator (support/platform tooling). Set this as a
    // custom claim with the Admin SDK; it can never be granted from the client.
    function isPlatformAdmin() {
      return isSignedIn() && request.auth.token.platformAdmin == true;
    }

    // Worker/company records must belong to the signed-in admin's own company.
    function ownsCompanyId(companyId) {
      return isSignedIn() &&
             (companyId == request.auth.uid ||
              companyId == 'company_' + request.auth.uid);
    }

    function sameCompany(companyId) {
      return isAdmin() && ownsCompanyId(companyId);
    }

    // ---------------------------------------------------------------------
    // USER TRACKING (analytics mirror)
    // ---------------------------------------------------------------------
    match /user_tracking/{userId} {
      // Self, same-company admins, or a platform admin. Never every admin.
      allow read: if isSelf(userId) ||
                     isPlatformAdmin() ||
                     (isSignedIn() && sameCompany(resource.data.companyId));

      allow create: if isSelf(userId) &&
                       hasVerifiedEmail() &&
                       request.resource.data.uid == userId &&
                       request.resource.data.email == request.auth.token.email;

      allow update: if isSelf(userId) &&
                       request.resource.data.uid == resource.data.uid &&
                       request.resource.data.email == resource.data.email;

      allow delete: if isSelf(userId) || isPlatformAdmin();
    }

    // ---------------------------------------------------------------------
    // WORKER TRACKING
    // ---------------------------------------------------------------------
    match /worker_tracking/{document} {
      allow read: if isSignedIn() &&
                     (resource.data.email == request.auth.token.email ||
                      isPlatformAdmin() ||
                      sameCompany(resource.data.companyId));

      allow create: if isSignedIn() &&
                       isAdmin() &&
                       ownsCompanyId(request.resource.data.companyId);

      allow update: if isSignedIn() &&
                       isAdmin() &&
                       ownsCompanyId(resource.data.companyId) &&
                       request.resource.data.companyId == resource.data.companyId;

      allow delete: if isSignedIn() &&
                       ((isAdmin() && ownsCompanyId(resource.data.companyId)) ||
                        resource.data.email == request.auth.token.email ||
                        isPlatformAdmin());
    }

    // ---------------------------------------------------------------------
    // COMPANY TRACKING
    // ---------------------------------------------------------------------
    match /company_tracking/{document} {
      allow read: if isSignedIn() &&
                     (resource.data.ownerId == request.auth.uid || isPlatformAdmin());

      allow create: if isSignedIn() &&
                       request.resource.data.ownerId == request.auth.uid &&
                       ownsCompanyId(request.resource.data.companyId);

      allow update: if isSignedIn() &&
                       resource.data.ownerId == request.auth.uid &&
                       request.resource.data.ownerId == request.auth.uid &&
                       request.resource.data.companyId == resource.data.companyId;

      allow delete: if isSignedIn() && resource.data.ownerId == request.auth.uid;
    }

    // ---------------------------------------------------------------------
    // USERS (account + workspace ids)
    // ---------------------------------------------------------------------
    match /users/{userId} {
      // Only the account owner (and a platform admin) can read a user document.
      // Company admins must not be able to read other companies' accounts.
      allow read: if isSelf(userId) || isPlatformAdmin();

      // New accounts must use their own verified Google email.
      allow create: if isSelf(userId) &&
                       hasVerifiedEmail() &&
                       request.resource.data.email == request.auth.token.email;

      // Self-service updates may not change the role or email (prevents
      // privilege escalation). Admin fields are managed by a server.
      allow update: if isSelf(userId) &&
                       request.resource.data.designation == resource.data.designation &&
                       request.resource.data.email == resource.data.email;

      // Account deletion
      allow delete: if isSelf(userId) || isPlatformAdmin();
    }

    // ---------------------------------------------------------------------
    // GOOGLE SHEETS DATA (legacy mirror)
    // ---------------------------------------------------------------------
    // The app stores workspace data in Google Sheets. This collection is not
    // written by any client, so keep it server-only to avoid a second copy of
    // company data being exposed.
    match /sheets_data/{document} {
      allow read, write: if isPlatformAdmin();
    }

    // ---------------------------------------------------------------------
    // NOTIFICATIONS COLLECTION
    // ---------------------------------------------------------------------
    match /notifications/{notificationId} {
      allow read: if isSignedIn() &&
                     (resource.data.ToWorkerID == request.auth.uid || isPlatformAdmin());

      // Alerts are written by company admins through Sheets, but keep the
      // legacy Firestore path locked to the recipient's own company.
      allow create: if isSignedIn() && isAdmin();

      // Recipients may only change read-state fields, never the target or body.
      allow update: if isSignedIn() &&
                       resource.data.ToWorkerID == request.auth.uid &&
                       request.resource.data.ToWorkerID == resource.data.ToWorkerID &&
                       request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['read', 'isRead', 'Read', 'readAt', 'updatedAt']);
    }

    // ---------------------------------------------------------------------
    // LEAVE REQUESTS COLLECTION
    // ---------------------------------------------------------------------
    match /leave_requests/{requestId} {
      allow read: if isSignedIn() &&
                     (resource.data.WorkerID == request.auth.uid ||
                      isManagerOrAdmin() ||
                      isPlatformAdmin());

      // A worker can only create a pending request for themselves. They cannot
      // self-approve by writing Status: approved.
      allow create: if isSignedIn() &&
                       request.resource.data.WorkerID == request.auth.uid &&
                       request.resource.data.Status == 'pending';

      // Managers/admins review the request but must not change whose it is.
      allow update: if isSignedIn() &&
                       (isManagerOrAdmin() || isPlatformAdmin()) &&
                       request.resource.data.WorkerID == resource.data.WorkerID;

      allow delete: if isSignedIn() &&
                       resource.data.WorkerID == request.auth.uid &&
                       resource.data.Status == 'pending';
    }

    // ---------------------------------------------------------------------
    // CLOCKINGS COLLECTION
    // ---------------------------------------------------------------------
    match /clockings/{clockingId} {
      allow read: if isSignedIn() &&
                     (resource.data.WorkerID == request.auth.uid ||
                      isManagerOrAdmin() ||
                      isPlatformAdmin());

      allow create: if isSignedIn() && (isAdmin() || isPlatformAdmin());
      allow update: if isSignedIn() && (isAdmin() || isPlatformAdmin());
      allow delete: if isSignedIn() && (isAdmin() || isPlatformAdmin());
    }

    // ---------------------------------------------------------------------
    // DRAWER MONEY COLLECTION
    // ---------------------------------------------------------------------
    match /drawer_money/{document} {
      allow read: if isSignedIn() &&
                     (resource.data.WorkerID == request.auth.uid ||
                      isManagerOrAdmin() ||
                      isPlatformAdmin());

      allow write: if isSignedIn() && (isAdmin() || isPlatformAdmin());
    }

    // ---------------------------------------------------------------------
    // PLATFORM-ONLY COLLECTIONS
    // ---------------------------------------------------------------------
    match /admin_logs/{document} {
      allow read, write: if isPlatformAdmin();
    }

    match /system_settings/{document} {
      allow read, write: if isPlatformAdmin();
    }
  }
}
