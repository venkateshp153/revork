# Google Sheets Configuration
EXPO_PUBLIC_API_KEY=your_api_key_here
EXPO_PUBLIC_SHEET_ID=your_spreadsheet_id_here
EXPO_PUBLIC_SHEET_NAME=MyProfile
EXPO_PUBLIC_RANGE=A1:E100
EXPO_PUBLIC_SHEETS_URL=https://sheets.googleapis.com/v4/spreadsheets/

# Road-routing fallback (OSRM). Optional; defaults to the public demo server.
# Use your own OSRM server for production traffic.
EXPO_PUBLIC_OSRM_URL=https://router.project-osrm.org

# Optional Maps-only key for Places API (New) + Routes API. When omitted, the
# app falls back to EXPO_PUBLIC_API_KEY (which may be restricted for Sheets).
EXPO_PUBLIC_MAPS_API_KEY=your_maps_api_key_here

# Optional Cloud Vision key for the admin "Scan address list" camera feature.
# Enable the Cloud Vision API for this key. When omitted, scanning is disabled
# but addresses can always be typed or pasted manually.
EXPO_PUBLIC_VISION_API_KEY=your_vision_api_key_here
