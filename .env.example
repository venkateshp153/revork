# ---------------------------------------------------------------------------
# Copy this file to .env and fill in your own values.
# .env is git-ignored. Never commit real keys.
# ---------------------------------------------------------------------------

# Google Sheets / Drive
# IMPORTANT: restrict this key in Google Cloud Console to the Android app
# package com.venky534.revork (+ release SHA-1) and to the Google Sheets API and
# Google Drive API only. Workspaces are private, so this key is only a legacy
# read fallback and cannot read private sheets.
EXPO_PUBLIC_API_KEY=your_api_key_here
EXPO_PUBLIC_SHEETS_URL=https://sheets.googleapis.com/v4/spreadsheets/

# Optional defaults for the legacy single-sheet helpers (not required by the
# current workspace flow).
EXPO_PUBLIC_SHEET_ID=
EXPO_PUBLIC_SHEET_NAME=MyProfile
EXPO_PUBLIC_RANGE=A1:E100

# Firebase web app config (public identifiers, safe to ship in the app).
EXPO_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
EXPO_PUBLIC_FIREBASE_APP_ID=your_app_id

# Google OAuth client ids (public identifiers).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your_web_client_id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your_ios_client_id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=your_android_client_id.apps.googleusercontent.com

# Road-routing fallback (OSRM). Optional; defaults to the public demo server.
# Use your own OSRM server for production traffic.
EXPO_PUBLIC_OSRM_URL=https://router.project-osrm.org

# Maps-only key for Places API (New) + Routes API. Restrict it to those APIs and
# to the release package + SHA-1. When omitted the app falls back to
# EXPO_PUBLIC_API_KEY.
EXPO_PUBLIC_MAPS_API_KEY=your_maps_api_key_here

# Cloud Vision key for the admin "Scan address list" feature. Restrict it to the
# Cloud Vision API and the release package + SHA-1. When omitted, scanning is
# disabled and addresses can still be typed or pasted.
EXPO_PUBLIC_VISION_API_KEY=your_vision_api_key_here

# Public URL of the hosted privacy policy. Required for Google Play Console.
# The app also ships an offline copy at app/privacy-policy.tsx.
EXPO_PUBLIC_PRIVACY_URL=https://your-domain.com/privacy

# Support contact shown in the privacy policy. Use a real, monitored mailbox.
EXPO_PUBLIC_SUPPORT_EMAIL=support@your-domain.com
